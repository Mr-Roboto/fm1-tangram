# Tangram 1.0 factory Performance Presets: focused host-only smoke.
# New bank must show four starters without writing flash at boot.
expect ux_bank_bytes 3748
expect ux_bank_slot1 1
expect ux_bank_slot3 1
expect ux_bank_flash_bytes -1
expect ux_perf_last_saved_slot 1

# The runtime intentionally refuses load/store until its MIDI drain guard
# has been idle for at least 5ms. The host boots at simulated time 0.
wait 10

# Each starter is a normal editable, reproducible project, not a new engine.
perfload 1
expect tpl 0
expect root 9
expect mode 0
expect bpm_proj 110
expect form 2
expect density_pct 85

perfload 2
expect tpl 2
expect root 2
expect mode 1
expect bpm_proj 72
expect form 3
expect density_pct 62

perfload 3
expect tpl 1
expect root 4
expect mode 0
expect bpm_proj 115
expect form 1
expect density_pct 80
expect chan5 9

perfload 4
expect tpl 0
expect root 0
expect mode 9
expect bpm_proj 112
expect form 1
expect density_pct 90

# Simulate upgrading a device with existing user material in slots 01 and 06.
# Occupied slots 01-04 are deliberately replaced once by factory starters.
# Slots 05-10 stay as they were; no repeated replacement on later reboot.
proj template full 0xABCDEF12
perfstore 1
perfstore 6
expect ux_bank_slot6 1
expect ux_bank_flash_version 3

# Host-only old-bank fixture: same 3748-byte content with historical v2 header.
v2bank
expect ux_bank_flash_version 2
reboot
wait 10
expect ux_bank_flash_version 3
expect ux_bank_slot1 1
expect ux_bank_slot3 1
expect ux_bank_slot6 1
perfload 1
expect tpl 0
expect bpm_proj 110
perfload 2
expect tpl 2
expect bpm_proj 72
perfload 3
expect tpl 1
expect bpm_proj 115
perfload 4
expect tpl 0
expect bpm_proj 112
perfload 6
expect tpl 1
expect bpm_proj 96

# After upgrade the bank is v3. A subsequent explicit user STORE in slot 1
# must survive a second reboot (factory material is not reinstalled every boot).
proj template full 0xABCDEF34
perfstore 1
reboot
wait 10
expect ux_bank_flash_version 3
perfload 1
expect tpl 1
expect bpm_proj 96
perfload 6
expect tpl 1
expect bpm_proj 96
