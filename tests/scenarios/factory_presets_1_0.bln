# Tangram 1.0 factory Performance Presets: focused host-only smoke.
# New bank must show four starters without writing flash at boot.
expect ux_bank_bytes 3748
expect ux_bank_slot1 1
expect ux_bank_slot3 1
expect ux_bank_flash_bytes -1
expect ux_perf_last_saved_slot 1

# The runtime intentionally refuses load/store until its MIDI drain guard
# has been idle for at least 5ms. The host boots at simulated time 0.
wait 10

# Each starter is a normal editable, reproducible project, not a new engine.
perfload 1
expect tpl 0
expect root 9
expect mode 0
expect bpm_proj 110
expect form 2
expect density_pct 85
expect ux_register_low 67
expect ux_register_high 91
expect ux_octave_shift_exact 1
expect ux_voice_bass_low 36

perfload 2
expect tpl 2
expect root 2
expect mode 1
expect bpm_proj 72
expect form 3
expect density_pct 62
expect ux_register_low 67
expect ux_register_high 91
expect ux_octave_shift_exact 1

perfload 3
expect tpl 1
expect root 4
expect mode 0
expect bpm_proj 115
expect form 1
expect density_pct 80
expect chan5 9
expect ux_register_low 67
expect ux_register_high 91
expect ux_octave_shift_exact 1
expect ux_voice_bass_low 36
expect ux_voice_kick_low 36

perfload 4
expect tpl 0
expect root 0
expect mode 9
expect bpm_proj 112
expect form 1
expect density_pct 90
expect ux_register_low 67
expect ux_register_high 91
expect ux_octave_shift_exact 1

# Simulate upgrading a device with existing material in slots 01 and 06.
# Both are deliberately discarded; slots 01-04 become the factory starters,
# 05-10 are left empty, and later user saves are NOT reset on reboot.
proj template full 0xABCDEF12
perfstore 1
perfstore 6
expect ux_bank_slot6 1
expect ux_bank_flash_version 4

# Host-only old-bank fixture: same 3748-byte content with historical v2 header.
v2bank
expect ux_bank_flash_version 2
reboot
wait 10
expect ux_bank_flash_version 4
expect ux_bank_slot1 1
expect ux_bank_slot3 1
expect ux_bank_slot6 0
perfload 1
expect tpl 0
expect bpm_proj 110
perfload 2
expect tpl 2
expect bpm_proj 72
perfload 3
expect tpl 1
expect bpm_proj 115
perfload 4
expect tpl 0
expect bpm_proj 112
# After upgrade the bank is v4. A subsequent explicit user STORE in slot 1
# must survive a second reboot (factory material is not reinstalled every boot).
proj template full 0xABCDEF34
perfstore 1
reboot
wait 10
expect ux_bank_flash_version 4
perfload 1
expect tpl 1
expect bpm_proj 96
expect ux_bank_slot6 0

# The firmware currently in the user's device already contains a populated
# version-3 bank. Its one-time v4 upgrade must overwrite OLD low registrations
# without disturbing subsequent explicit v4 user saves.
proj template full 0xABCDEF55
perfstore 1
perfstore 6
expect ux_bank_slot6 1
expect ux_bank_flash_version 4
v3bank
expect ux_bank_flash_version 3
reboot
wait 10
expect ux_bank_flash_version 4
expect ux_bank_slot1 1
expect ux_bank_slot6 0
perfload 1
expect bpm_proj 110
expect ux_register_low 67
expect ux_register_high 91
expect ux_octave_shift_exact 1
expect ux_voice_bass_low 36
