# The encoders and the pot (spec, Controls: Encoders and the pot), one expect a row:
#   MASTER     density 0-100 % in steps of 1 % ((plat_master() * 100 + 2048) / 4096: 0 % up to 20, 100 % from
#              4076, the device's pot tops out at about 4092), with hysteresis on the reading: the place last taken
#              is left only by a move of 60 counts (a step and a half) or into an end step; a move is sent once it
#              has held (within a step) 150 ms; playing, at the next bar. At boot the saved density wins: the first
#              reading that holds within a step for 30 ms is the pot's place, taken, not sent; it takes over once it
#              moves from there (Rulings AB, AD)
#   SELECT     the selected voice (the template's, in key order); HOME held: the tempo (HOME then no page)
#   ALGORITHM  the scale mode (the key's root kept), round
#   PRESETS    the template (a fresh seed), round; while playing it takes over at the next bar
#   KNOB 1-4   the page's four values the Mac can change: Perform tempo, AUTO, form, ambient (form and ambient
#              stopped only); Voice the selected voice's channel; Setup root, sync (stopped only), EXT input,
#              lights; Pattern the ratchet (ratchet.bln). The rest are shown, their knobs do nothing.
proj template demo 0x5EED1234
# ---- MASTER: the pot settled where it is at boot (2048, 50 %) sends nothing
wait 300
expect density_pct 100
expect has_density 0
master 1024
expect density_pct 100
wait 150
expect density_pct 25
expect has_density 1
# a pot still moving sends nothing until it holds
master 2000
wait 100
master 2100
wait 100
expect density_pct 25
wait 60
expect density_pct 51
# a pot resting on a step's edge (2100 is 51 %, 2110 52 %: a few counts of noise), for 2 s: nothing new
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
master 2110
master 2100
wait 200
expect density_pct 51
# less than a step and a half is no move (2140: 52 %); more is (2170: 53 %)
master 2140
wait 200
expect density_pct 51
master 2170
wait 200
expect density_pct 53
# the ends of the travel: 100 % and 0 %, reached by a small last move into them too
master 4040
wait 200
expect density_pct 99
master 4092
wait 200
expect density_pct 100
master 4060
wait 200
expect density_pct 100
master 60
wait 200
expect density_pct 1
master 10
wait 200
expect density_pct 0
master 2048
wait 200
expect density_pct 50
# ---- SELECT: the voices the Demo trio has, in key order, kept within them
expect voice_sel 0
turn SELECT 1
expect voice_sel 1
turn SELECT 5
expect voice_sel 2
turn SELECT -1
expect voice_sel 1
# HOME + SELECT: the tempo (from the Voice page: HOME's release then shows no page)
tap ENV
press HOME
turn SELECT 3
release HOME
expect bpm_proj 93
expect bpm 93
expect view 1
expect voice_sel 1
# ---- ALGORITHM: the mode, A kept, round
expect mode 0
turn ALGO 1
expect mode 1
expect root 9
turn ALGO -2
expect mode 9
# ---- KNOB 1 on the Voice page: Pluck 2's channel (the selected voice)
expect chan1 1
turn K1 2
expect chan1 3
# its loop length (KNOB 2): shown, not editable
turn K2 3
expect chan1 3
# ---- Perform: AUTO on, the form, ambient mode (stopped)
tap HOME
expect arr_on 0
turn K2 1
expect arr_on 1
expect form 0
turn K3 1
expect form 1
turn K3 1
expect form 2
expect arr_on 1
turn K4 1
expect arr_ambient 1
# ---- Setup: root, sync, the EXT input, lights
tap GLO
turn K1 -2
expect root 7
turn K2 1
expect sync 1
turn K2 -1
expect sync 0
expect ext_ports 5
turn K3 -1
expect ext_ports 4
turn K3 -1
expect ext_ports 1
turn K4 1
expect lights 2
turn K4 -2
expect lights 0
turn K4 1
expect lights 1
# ---- PRESETS stopped: the template at once (Full ensemble: its Pad on the fourth key)
turn PRESET 1
expect tpl 1
expect key_led3 2
turn PRESET -2
expect tpl 2
turn PRESET 1
expect tpl 0
# while playing: the project's at once, the running engine's at the next bar (the Pad comes in there)
tap PLAY
wait 500
expect active3 -1
turn PRESET 1
expect tpl 1
expect active3 -1
wait 2700
expect active3 1
# the form while playing: stopped only, said
tap HOME
expect warns 0
turn K3 1
expect warns 1
# the density while playing: the project's at once
master 3072
wait 200
expect density_pct 75
tap PLAY
# ---- at boot the saved density wins (Ruling AD): 35 % saved; at the restart the platform reports the pot's middle
# (2048, as the device's before its smoothing catches up), then its place (3000, 73 %); the pot then rests on a
# step's edge (3000 73 %, 3020 74 %) for 2 s: the project's 35 % stays
wait 100
master 1434
wait 200
expect density_pct 35
tap SAVE
master 2048
reboot
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
master 3020
master 3000
wait 500
expect density_pct 35
# a real move from where it settled is the pot's
master 1000
wait 200
expect density_pct 24
# a move right after the restart (40 ms on, before the pot has been still long) is the pot's too
master 2048
reboot
expect density_pct 35
master 3000
master 1000
wait 200
expect density_pct 24
