midi TRS F8
wait 18
# the notes went out on the followed clock
expect midi_out >20
# the 96th pulse is tick 3800, 19 ms ago (a "midi" line runs 2 ms): 38 ticks on, then held short of the next
expect tick_rate 2000
expect tick 3838
wait 10
expect tick 3839
# no pulse: held on 3839 to 500 ms after the last, then on at 2 ticks per ms (1529 ms of the 2 s: 3839 + 3058)
wait 2000
expect playing 1
expect tick_rate 2000
expect tick 6897
expect clocks_out 0
# the pulses again: on from the tick reached (6899: the pulse is 6920, the next multiple of 40), never back
midi TRS F8
expect tick 6922
expect tick_rate 2000
wait 18
midi TRS F8
expect tick 6962
midi TRS FC
expect playing 0
expect sounding 0
expect clocks_out 0
