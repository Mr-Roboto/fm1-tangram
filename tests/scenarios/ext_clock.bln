# the notes went out on the followed clock; the 96th pulse is tick 3800, 19 ms ago (a "midi" line runs 2 ms): 38
# ticks on, then held short of the next: after FA and N pulses the tick is in 40 (N - 1) ... 40 N - 1, no lead
expect midi_out >20
expect tick_rate 2000
expect bpm 125
expect tick 3838
expect tick >3799
expect tick <3840
wait 10
expect tick 3839
# no pulse: held on 3839 to 500 ms after the last, then on at 2 ticks per ms (1529 ms of the 2 s: 3839 + 3058)
wait 2000
expect playing 1
expect tick_rate 2000
expect bpm 125
expect tick 6897
expect clocks_out 0
# the pulses again: on from the tick reached (6899: the pulse is 6920, the next multiple of 40), never back
midi TRS F8
expect tick 6922
expect tick_rate 2000
wait 18
midi TRS F8
expect tick 6962
midi TRS FC
expect playing 0
wait 1
expect sounding 0
expect clocks_out 0
# Stopped in EXT, retain the measured 125 BPM. Switching to global INTERNAL explicitly selects
# the project's 96 BPM; switching back to EXTERNAL retains that rate until new clock pulses arrive.
expect bpm_shown 125
expect bpm_proj 96
proj sync int
expect sync 0
expect bpm 96
expect bpm_shown 96
expect tick_rate 1536
expect ext_ports 4
proj sync ext
expect sync 1
expect ext_ports 4
expect bpm 96
expect tick_rate 1536
# a SAVE made while playing in EXT is written after MIDI Stop, once what the stop sends has gone out (a flash write
# stops everything for a moment: the offs would wait behind it): 128 notes sounding, their offs 8 ms on the wire
tap PLAY
wait 300
tap SAVE
expect save_pending 1
rt burst 128
wait 8
expect sounding15 >100
midi TRS FC
wait 40
expect playing 0
expect save_pending 0
# Clock edits coalesce into one device-settings record, deferred until stopped/idle and settled
# for 250 ms. SAVE writes a separate musical project record: two writes, not one per clock edit.
# Both writes have completed here; no new clock edits follow before reboot.
expect store_writes 2
expect save_unsent 0
expect sounding 0
expect sync 1
expect ext_ports 4
# The compatibility command edits global sync. Loading Ambient drift stores project BPM 72,
# but EXT keeps the current runtime estimate (96 after the explicit INTERNAL switch above).
# No new F8 pulses arrive in this section; project loading must not retime the external clock.
proj sync ext
proj template ambient 1
expect bpm_proj 72
expect sync 1
expect ext_ports 4
expect bpm 96
expect tick_rate 1536
tap PLAY
wait 500
expect playing 1
expect bpm_proj 72
expect bpm 96
expect tick_rate 1536
tap PLAY
expect sync 1
expect ext_ports 4
# SAVE persists the musical BPM independently. Global EXT/TRS was already persisted at the earlier STOP;
# reboot reloads it, but never restores a measured tempo: runtime starts at its documented 96 BPM fallback.
save
reboot
expect sync 1
expect ext_ports 4
expect bpm_proj 72
expect bpm 96
expect tick_rate 1536
tap PLAY
wait 500
expect playing 1
expect sync 1
expect ext_ports 4
expect bpm_proj 72
expect bpm 96
expect tick_rate 1536
tap PLAY
# an FC that the tick takes between an FA and the main loop's start (its interrupt between app_loop's look and the
# start's lock) takes the FA back: nothing starts, nothing free-runs while the master is stopped
racefc
midi TRS FA
expect playing 0
wait 500
expect playing 0
expect tick 0
expect clocks_out 0
