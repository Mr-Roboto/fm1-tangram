# Tangram 1.0 UX layout phase 2: a pure display-name change.
# ENV keeps TWO subpages and the original four encoder bindings on each.
expect ux_env_pages 2
expect ux_env_timing_unchanged 1
expect ux_env_voice_unchanged 1
tap ENV
expect ux_env_is_voice 0
tap ENV
expect ux_env_is_voice 1
tap ENV
expect ux_env_is_voice 0

# A selected melodic voice must offer K2 REGISTER and move exactly one octave
# per encoder step, without touching its note-generation pitch offsets.
# The earlier layout checks left us on ENV TIMING.
expect ux_env_is_voice 0
tap ENV
expect ux_env_is_voice 1
expect ux_register_k2_available 1
# Tangram's melodic templates were retuned +12 at project->engine boundary.
# The editable display starts at 67..91; K2 still shifts exactly 12.
expect ux_register_low 67
expect ux_register_high 91
turn K2 1
expect ux_register_low 79
expect ux_register_high 103
turn K2 -1
expect ux_register_low 67
expect ux_register_high 91
