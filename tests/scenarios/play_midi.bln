# What the transport sends is what Berlinan's sends: tests/equiv/midi_full.midiscript (the full ensemble on its own
# seed, 64 bars, two transpositions, mutes, Ambient drift loaded in bar 46) played on the app, every message it sends
# logged with its tick, and the log compared line by line with what RefTool's midi mode writes for the same script
# (midi_full.midiref: Start, the notes and CC of each window of 240 ticks as NoteEventConverter makes them, the
# clock, in a stable sort by tick).
selfscript tests/equiv/midi_full.midiscript
dumpmidi app/build/scenarios/play_midi/midi_dump.txt
tap PLAY
expect playing 1
# tick 0 sounds 100 ms after the press; 47 bars at 96 BPM (117.5 s), then 17 of Ambient drift at 72 (56.7 s)
wait 175000
expect head 245760
expect tick >245760
cmpmidi tests/equiv/midi_full.midiref
expect midicmp 0
expect midilines 8559
expect sounding 0
expect queued 0
expect dropped 0
expect clocks_out 6144
